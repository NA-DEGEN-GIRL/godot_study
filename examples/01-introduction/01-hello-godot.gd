# Chapter 01 - Godot Engine Introduction
# 01-hello-godot.gd - Hello World and Basic Script Structure
#
# 이 파일에서 배울 내용:
# - GDScript의 기본 구조와 extends 키워드
# - print() 함수를 이용한 출력
# - _ready() 라이프사이클 함수의 역할
# - 기본적인 노드 스크립트 작성법

extends Node

# ============================================
# 1. Hello World - 첫 번째 GDScript
# ============================================

# Godot에서 모든 스크립트는 노드에 "붙어서(attach)" 실행됩니다.
# extends Node는 이 스크립트가 Node 클래스를 상속한다는 뜻입니다.
# _ready()는 노드가 씬 트리에 들어갈 때 자동으로 호출됩니다.

func _ready():
	print("=== Hello World ===\n")

	# print()는 Godot의 출력 함수입니다 (Output 패널에 표시)
	print("Hello, Godot!")
	print("안녕하세요, Godot Engine 4!")

	# 여러 값을 쉼표로 구분하여 출력할 수 있습니다
	print("Godot", " ", "Engine", " ", 4)

	# ============================================
	# 2. print() 함수의 다양한 사용법
	# ============================================
	print("\n=== print() 함수 활용 ===\n")

	# 기본 print - 자동으로 줄바꿈이 추가됩니다
	print("첫 번째 줄")
	print("두 번째 줄")

	# 여러 값을 한 번에 출력 (자동으로 공백 없이 연결)
	print("이름: ", "Godot", ", 버전: ", 4)

	# 문자열 포맷팅 - % 연산자 사용
	var engine_name := "Godot"
	var version := 4
	print("엔진: %s, 버전: %d" % [engine_name, version])

	# 문자열 포맷팅 - format() 메서드 사용
	print("엔진: {name}, 버전: {ver}".format({"name": "Godot", "ver": 4}))

	# printerr() - 에러 출력 (빨간색으로 표시됨)
	printerr("이것은 에러 메시지입니다")

	# prints() - 값 사이에 자동으로 공백 추가
	prints("A", "B", "C", "D")  # 출력: A B C D

	# printt() - 값 사이에 탭 문자 추가
	printt("이름", "나이", "직업")  # 출력: 이름	나이	직업

	# printraw() - 줄바꿈 없이 출력
	printraw("줄바꿈 ")
	printraw("없이 ")
	printraw("연결됨\n")

	# ============================================
	# 3. _ready() 함수의 역할
	# ============================================
	print("\n=== _ready() 라이프사이클 ===\n")

	# _ready()는 가상 함수(virtual function)입니다.
	# Godot 엔진이 자동으로 호출하며, 직접 호출할 필요가 없습니다.
	#
	# 호출 시점:
	# 1. 노드가 씬 트리에 추가될 때
	# 2. 모든 자식 노드의 _ready()가 먼저 호출된 후
	# 3. 단 한 번만 호출됩니다
	#
	# 주요 용도:
	# - 변수 초기화
	# - 다른 노드 참조 획득
	# - 시그널 연결
	# - 초기 설정

	print("_ready()가 호출되었습니다!")
	print("이 코드는 노드가 준비되었을 때 실행됩니다.")

	# 노드 이름 확인
	print("현재 노드 이름: ", name)

	# ============================================
	# 4. 기본 스크립트 구조 이해
	# ============================================
	print("\n=== 기본 스크립트 구조 ===\n")

	# GDScript는 Python과 비슷한 문법을 가집니다:
	# - 들여쓰기(탭)로 코드 블록을 구분
	# - 세미콜론(;) 불필요
	# - 동적 타이핑 + 선택적 정적 타이핑

	# 기본적인 변수 선언
	var message = "GDScript는 쉽습니다!"
	print(message)

	# 타입을 명시한 변수 선언 (권장)
	var number: int = 42
	print("숫자: ", number)

	# 타입 추론 (:= 연산자)
	var pi := 3.14  # float로 자동 추론
	print("PI 값: ", pi)

	# ============================================
	# 5. 주석 작성법
	# ============================================
	print("\n=== 주석 (Comments) ===\n")

	# 한 줄 주석 - '#' 기호를 사용합니다
	print("한 줄 주석은 # 기호를 사용합니다")

	# GDScript에는 여러 줄 주석(/* */)이 없습니다.
	# 대신 여러 줄의 # 주석을 사용하거나,
	# 문서화 주석(##)을 사용합니다.

	## 이것은 문서화 주석입니다.
	## 에디터에서 변수나 함수에 대한 설명으로 표시됩니다.

	# 주석은 코드 설명, TODO 메모, 디버깅 등에 활용합니다
	# TODO: 나중에 이 부분을 개선하기
	# FIXME: 이 버그를 수정해야 함
	# NOTE: 중요한 참고사항

	print("주석은 실행되지 않습니다 - 개발자를 위한 메모입니다")

	# ============================================
	# 6. 정리
	# ============================================
	print("\n=== 정리 ===\n")

	print("1. 모든 스크립트는 extends로 시작합니다")
	print("2. _ready()는 노드 초기화 시 호출됩니다")
	print("3. print()로 디버깅 출력을 합니다")
	print("4. GDScript는 들여쓰기 기반 언어입니다")
	print("5. #으로 주석을 작성합니다")
